{
  "name": "linkedinjobscraper",
  "version": "1.0.0",
  "description": "A server that continously scrapes new Jobs from LinkedIn collects them in a database",
  "license": "ISC",
  "author": "freshmozart",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#scrapers/*": {
      "types": "./src/scrapers/*",
      "development": "./src/scrapers/*",
      "default": "./dist/scrapers/*"
    },
    "#types": {
      "types": "./src/types.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#database/*": {
      "types": "./src/database/*",
      "development": "./src/database/*",
      "default": "./dist/database/*"
    },
    "#index": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "mongo": "mongod --dbpath /opt/homebrew/var/mongodb",
    "test": "npm run test:watch",
    "test:once": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:watch": "nodemon --watch src --watch jest.config.mjs --watch package.json --ext ts,mjs,json --exec \"npm run test:once\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "qs": "^6.15.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.2.0",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "puppeteer": "^25.1.0"
  }
}
