# MongoDB connection URI; checked at startup and before every DB call
MONGODB_CONNECTION_STRING=

# OpenAI API key; picked up automatically by the OpenAI SDK.
# Required at process startup (cover-letter-generator constructs an OpenAI
# client at import time), not just at call time.
OPENAI_API_KEY=

# Optional. Overrides Python binary resolution for the token service subprocess.
# PYTHON=
