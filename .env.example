# MongoDB connection URI; checked at startup and before every DB call
MONGODB_CONNECTION_STRING=

# OpenAI API key; picked up automatically by the OpenAI SDK.
# Required at process startup (cover-letter-generator constructs an OpenAI
# client at import time), not just at call time.
OPENAI_API_KEY=

# Optional. Overrides Python binary resolution for the token service subprocess.
# PYTHON=

# Optional additional frontend origins for deployment/LAN access (comma-separated).
# Exact HTTP(S) origins only: no trailing slash, path, query, hash or credentials.
# Invalid entries stop startup. Localhost/127.0.0.1 dev (5173) and preview (4173),
# plus existing valid 192.168.*.*:5173 HTTP origins, remain allowed by default.
# CORS_ALLOWED_ORIGINS=https://jobs.example.com,http://10.0.0.10:5173
